<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/category_chip"
    style="@style/Widget.FidalGO.CategoryPill"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/category_pill_height"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:chipBackgroundColor="@color/category_pill_bg_selector"
    android:textColor="@color/category_pill_text_selector"
    android:fontFamily="sans-serif-medium"
    android:textSize="@dimen/text_size_sm" />