<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado focado + pressionado -->
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg_active" />
            <stroke android:width="@dimen/focus_border_width" android:color="@color/tv_focus_border" />
            <corners android:radius="@dimen/channel_card_corner_radius" />
        </shape>
    </item>
    <!-- Estado focado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus_bg" />
            <stroke android:width="@dimen/focus_border_width" android:color="@color/tv_focus_border" />
            <corners android:radius="@dimen/channel_card_corner_radius" />
        </shape>
    </item>
    <!-- Estado pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fidalgo_purple" />
            <stroke android:width="2dp" android:color="@color/fidalgo_accent" />
            <corners android:radius="@dimen/channel_card_corner_radius" />
        </shape>
    </item>
    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_bg_card" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="@dimen/channel_card_corner_radius" />
        </shape>
    </item>
</selector>