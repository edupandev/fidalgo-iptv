<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/glass_bg_active" />
            <stroke android:width="2dp" android:color="@color/tv_focus_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/fidalgo_purple" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/tv_bg_card" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>