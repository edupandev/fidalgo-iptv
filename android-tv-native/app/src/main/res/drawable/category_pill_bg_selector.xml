<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg_active" />
            <stroke android:width="1dp" android:color="@color/glass_border_active" />
            <corners android:radius="@dimen/category_pill_corner_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fidalgo_purple" />
            <corners android:radius="@dimen/category_pill_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="@dimen/category_pill_corner_radius" />
        </shape>
    </item>
</selector>